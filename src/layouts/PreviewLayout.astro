---
import "@fontsource/inter/400.css";
import "@fontsource/inter/500.css";
import "@fontsource/inter/600.css";
import "@fontsource/inter/700.css";
import "@fontsource/inter/800.css";
import "@fontsource/inter/900.css";
import "@jjlmoya/utils-shared/theme.css";
import PreviewToolbar from "../components/PreviewToolbar.astro";
import type { KnownLocale } from "../types";

interface Props {
    title: string;
    currentLocale?: KnownLocale;
    localeUrls?: Partial<Record<KnownLocale, string>>;
    hasSidebar?: boolean;
    fullBleed?: boolean;
}

const { title, currentLocale = "es", localeUrls = {}, hasSidebar = false, fullBleed = false } = Astro.props;
---

<!doctype html>
<html lang={currentLocale}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <title>{title} · preview</title>
        <script is:inline>
            (function () {
                const aliases = { light: "theme-light", dark: "theme-dark", system: "theme-system" };
                const stored = localStorage.getItem("theme") || "theme-system";
                const preference = aliases[stored] || stored;
                const selected = ["theme-light", "theme-dark", "theme-system"].includes(preference)
                    ? preference
                    : "theme-system";
                const isDark = selected === "theme-dark" || (
                    selected === "theme-system" && window.matchMedia("(prefers-color-scheme: dark)").matches
                );
                const root = document.documentElement;
                root.classList.remove("theme-light", "theme-dark", "theme-system", "dark");
                root.classList.add(selected, isDark ? "theme-dark" : "theme-light");
                root.classList.toggle("dark", isDark);
            })();
        </script>
        <slot name="head" />
    </head>
    <body>
        <PreviewToolbar currentLocale={currentLocale} localeUrls={localeUrls} />
        <div class:list={["page-wrapper", { "with-sidebar": hasSidebar }]}>
            {
                hasSidebar && (
                    <aside class="sidebar-area">
                        <slot name="sidebar" />
                    </aside>
                )
            }
            <main class:list={[{ "full-bleed": fullBleed }]}>
                <slot />
            </main>
        </div>
    </body>
</html>

<style is:global>
    :root {
        --accent: #f43f5e;
        --primary-base: #9f1239;
    }

    .theme-dark,
    .theme-light {
        --text-main: var(--text-base);
        --border-color: var(--border-base);
    }

    *,
    *::before,
    *::after {
        box-sizing: border-box;
    }

    body {
        font: 400 16px/normal Inter, system-ui, sans-serif;
        background-color: var(--bg-page);
        color: var(--text-base);
        margin: 0;
        min-height: 100vh;
        transition:
            background-color 0.3s ease,
            color 0.3s ease;
    }

    main {
        padding: 0 2rem;
        min-width: 0;
    }

    main.full-bleed { padding: 0; }

    .page-wrapper {
        display: flex;
        flex-direction: column;
    }

    .page-wrapper.with-sidebar {
        display: grid;
        grid-template-columns: 240px 1fr;
        min-height: 100vh;
    }

    .sidebar-area {
        position: sticky;
        top: 0;
        height: 100vh;
        overflow-y: auto;
        border-right: 1px solid var(--border-color);
        background: var(--bg-page);
    }

    @media (max-width: 768px) {
        .page-wrapper.with-sidebar {
            grid-template-columns: 1fr;
        }

        .sidebar-area {
            display: none;
        }
    }
</style>
