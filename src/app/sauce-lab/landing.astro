---
import type { KnownLocale } from '../../types';
import { Icon } from 'astro-icon/components';
import { sauceLabEntry } from './entry';
import { localizedAppStoreUrl } from '../../app-store';
import './sauce-lab.css';
import Hero from './components/Hero.astro';
import Philosophy from './components/Philosophy.astro';
import Benefits from './components/Benefits.astro';
import Hierarchy from './components/Hierarchy.astro';
import Chemistry from './components/Chemistry.astro';
import Atlas from './components/Atlas.astro';
import Fix from './components/Fix.astro';

interface Props {
    locale: KnownLocale;
}

const { locale } = Astro.props;

const loaders = {
    es: () => import('./i18n/es').then((m) => m.landingContent),
    de: () => import('./i18n/de').then((m) => m.landingContent),
    en: () => import('./i18n/en').then((m) => m.landingContent),
    fr: () => import('./i18n/fr').then((m) => m.landingContent),
    id: () => import('./i18n/id').then((m) => m.landingContent),
    it: () => import('./i18n/it').then((m) => m.landingContent),
    ja: () => import('./i18n/ja').then((m) => m.landingContent),
    ko: () => import('./i18n/ko').then((m) => m.landingContent),
    nl: () => import('./i18n/nl').then((m) => m.landingContent),
    pl: () => import('./i18n/pl').then((m) => m.landingContent),
    pt: () => import('./i18n/pt').then((m) => m.landingContent),
    ru: () => import('./i18n/ru').then((m) => m.landingContent),
    sv: () => import('./i18n/sv').then((m) => m.landingContent),
    tr: () => import('./i18n/tr').then((m) => m.landingContent),
    zh: () => import('./i18n/zh').then((m) => m.landingContent),
};

const t = await (loaders[locale as keyof typeof loaders] ?? loaders.en)();
const { stores: baseStores, id: appId } = sauceLabEntry;

const stores = {
    ...baseStores,
    ...(baseStores.appStore ? { appStore: localizedAppStoreUrl(baseStores.appStore, locale) } : {}),
};

const hasGooglePlay = !!stores.googlePlay;
const hasAppStore = !!stores.appStore;
---

<div class="sl-landing">
    <div class="sl-noise"></div>
    <Hero t={t.hero} {stores} {appId} />
    
    <div class="sl-main-content">
        <Philosophy t={t.philosophy} {appId} />
        <Benefits t={t.benefits} />
        <Hierarchy t={t.hierarchy} {appId} />
        <Chemistry t={t.chemistry} {appId} />
        <Atlas t={t.atlas} {appId} />
        <Fix t={t.fix} {appId} />
        
        <section class="sl-final-cta">
            <div class="sl-container">
                <div class="sl-cta-card">
                    <h2 class="sl-cta-title">Ready to master the <span class="sl-text-accent">Saucier</span>?</h2>
                    <p class="sl-cta-text">Join thousands of chefs using SauceLab to craft the perfect heritage.</p>
                    <div class="sl-hero-actions">
                        <div class:list={["sl-btn-wrapper", { 'disabled': !hasAppStore }]}>
                            <a href={hasAppStore ? stores.appStore : 'javascript:void(0)'} class="sl-btn sl-btn-primary">
                                <Icon name="mdi:apple" class="sl-btn-icon" />
                                <span>App Store</span>
                            </a>
                            {!hasAppStore && <span class="sl-btn-status">{t.hero.comingSoon}</span>}
                        </div>

                        <div class:list={["sl-btn-wrapper", { 'disabled': !hasGooglePlay }]}>
                            <a href={hasGooglePlay ? stores.googlePlay : 'javascript:void(0)'} class="sl-btn sl-btn-secondary">
                                <Icon name="mdi:google-play" class="sl-btn-icon" />
                                <span>Google Play</span>
                            </a>
                            {!hasGooglePlay && <span class="sl-btn-status">{t.hero.comingSoon}</span>}
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>
</div>
