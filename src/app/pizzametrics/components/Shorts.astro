---
import type { PizzametricsShorts } from '../types';
import YouTubeVideo from '../../../components/YouTubeVideo.astro';

interface Props {
    t: PizzametricsShorts;
    shortIds: string[];
}

const { t, shortIds } = Astro.props;
const posters = [
    '/assets/apps/pizzametrics/screenshot_real.webp',
    '/assets/apps/pizzametrics/dashboard.webp',
    '/assets/apps/pizzametrics/calculator.webp',
    '/assets/apps/pizzametrics/pantry.webp',
    '/assets/apps/pizzametrics/screenshot-6-list-history.webp',
];
---

<section class="pm-shorts">
    <div class="pm-shorts-inner">
        <div class="pm-shorts-header">
            <h2 class="pm-shorts-title">
                {t.titleMain} <span class="pm-shorts-title-highlight">{t.titleHighlight}</span>
            </h2>
            <hr class="pm-shorts-divider" />
            <p class="pm-shorts-subtitle">{t.subtitle}</p>
        </div>

        <div class="pm-shorts-grid">
            {
                shortIds.map((id, index) => (
                    <div class="pm-short-item">
                        <YouTubeVideo
                            videoId={id}
                            title={`${t.titleMain} ${index + 1}`}
                            poster={posters[index % posters.length] ?? '/assets/apps/pizzametrics/dashboard.webp'}
                        />
                    </div>
                ))
            }
        </div>
    </div>
</section>
