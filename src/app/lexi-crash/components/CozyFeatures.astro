---
import type { LexiCrashCozyFeatures } from '../types';

interface Props {
    t: LexiCrashCozyFeatures;
    appId: string;
}

const { t, appId } = Astro.props;
---

<section class="lc-features" aria-labelledby="lc-features-title">
    <div class="lc-features-inner">
        <div class="lc-section-intro">
            <span class="lc-eyebrow">{t.eyebrow}</span>
            <h2 id="lc-features-title" class="lc-features-title">{t.titleMain}<br /><span>{t.titleHighlight}</span></h2>
            <p class="lc-section-subtitle">{t.subtitle}</p>
        </div>

        <div class="lc-features-grid">
            <article class="lc-feature-card lc-feature-card--lavender">
                <div class="lc-feature-art lc-feature-art--home">
                    <img
                        src={`/assets/apps/${appId}/arcade-master/scenes/home-light.png`}
                        alt={t.cards[0].alt}
                        loading="lazy"
                    />
                    <span class="lc-feature-spark">&#x2726;</span>
                    <span class="lc-feature-spark lc-feature-spark--two">&#x2727;</span>
                </div>
                <div class="lc-feature-copy">
                    <span class="lc-feature-number">01</span>
                    <h3>{t.cards[0].title}</h3>
                    <p>{t.cards[0].description}</p>
                </div>
            </article>

            <article class="lc-feature-card lc-feature-card--peach">
                <div class="lc-feature-art">
                    <img src={`/assets/apps/${appId}/arcade-master/05-crash.png`} alt={t.cards[1].alt} loading="lazy" />
                    <span class="lc-feature-art-burst" aria-hidden="true">&#x2726;</span>
                </div>
                <div class="lc-feature-copy">
                    <span class="lc-feature-number">02</span>
                    <h3>{t.cards[1].title}</h3>
                    <p>{t.cards[1].description}</p>
                </div>
            </article>

            <article class="lc-feature-card lc-feature-card--blue">
                <div class="lc-feature-art">
                    <img src={`/assets/apps/${appId}/arcade-master/03-stats.png`} alt={t.cards[2].alt} loading="lazy" />
                    <span class="lc-feature-art-burst lc-feature-art-burst--blue" aria-hidden="true">&#x2727;</span>
                </div>
                <div class="lc-feature-copy">
                    <span class="lc-feature-number">03</span>
                    <h3>{t.cards[2].title}</h3>
                    <p>{t.cards[2].description}</p>
                </div>
            </article>
        </div>
    </div>
</section>
