---
import { Icon } from 'astro-icon/components';
import type { LexiCrashGameModes } from '../types';

interface Props {
    t: LexiCrashGameModes;
    appId: string;
}

const { t, appId } = Astro.props;

const modes = [
    { data: t.crash, artwork: '05-crash.webp', variant: 'coral', icon: 'mdi:lightning-bolt' },
    { data: t.relax, artwork: '07-relax.webp', variant: 'lavender', icon: 'mdi:weather-sunny' },
    { data: t.daily, artwork: '04-daily.webp', variant: 'blue', icon: 'mdi:calendar-star' },
];
---

<section class="lc-modes">
    <div class="lc-modes-inner">
        <div class="lc-modes-header">
            <h2 class="lc-modes-title">
                {t.titleMain} <span class="lc-modes-title-hl">{t.titleHighlight}</span>
            </h2>
            <p class="lc-modes-subtitle">{t.subtitle}</p>
        </div>

        <div class="lc-modes-grid">
            {modes.map(({ data, artwork, variant, icon }) => (
                <article class={`lc-mode-card lc-mode-card--${variant}`}>
                    <div class="lc-mode-img-wrapper">
                        <img
                            src={`/assets/apps/${appId}/arcade-master/${artwork}`}
                            alt={data.alt}
                            class="lc-mode-img"
                            loading="lazy"
                        />
                        <span class="lc-mode-kicker">{data.kicker}</span>
                        <div class="lc-mode-icon">
                            <Icon name={icon} class="lc-mode-icon-svg" />
                        </div>
                    </div>
                    <div class="lc-mode-content">
                        <h3 class="lc-mode-name">{data.title}</h3>
                        <p class="lc-mode-desc">{data.description}</p>
                    </div>
                </article>
            ))}
        </div>
    </div>
</section>
