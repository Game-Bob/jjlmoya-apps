---

<div class="lc-bg">
    <div class="lc-bg-glow lc-bg-glow-top"></div>
    <div class="lc-bg-glow lc-bg-glow-middle"></div>
    <div class="lc-bg-glow lc-bg-glow-bottom"></div>
    <div class="lc-bg-bubbles" aria-hidden="true">
        {bubbles.map(({ x, y, size, delay, duration, variant }) => (
            <span
                class:list={["lc-bg-bubble", `lc-bg-bubble--${variant}`]}
                style={`--lc-bubble-x: ${x}%; --lc-bubble-y: ${y}%; --lc-bubble-size: ${size}rem; --lc-bubble-delay: ${delay}s; --lc-bubble-duration: ${duration}s;`}
            ></span>
        ))}
    </div>
    <div class="lc-bg-letters">
        {items.map(({ letter, x, y, delay, duration, size, rotate }, index) => (
            <span
                class:list={["lc-bg-letter", { "lc-bg-letter-mobile-hide": index % 2 === 1 }]}
                style={`--lc-letter-delay: ${delay}s; --lc-letter-x: ${x}%; --lc-letter-y: ${y}%; --lc-letter-duration: ${duration}s; --lc-letter-size: ${size}rem; --lc-letter-rotate: ${rotate}deg;`}
            >{letter}</span>
        ))}
    </div>
    <div class="lc-bg-stars" aria-hidden="true">
        {stars.map(({ glyph, x, y, delay, duration, size, variant }) => (
            <span
                class:list={["lc-bg-star", `lc-bg-star--${variant}`, `lc-bg-star--${glyph}`]}
                style={`--lc-star-x: ${x}%; --lc-star-y: ${y}%; --lc-star-delay: ${delay}s; --lc-star-duration: ${duration}s; --lc-star-size: ${size}rem;`}
            ></span>
        ))}
    </div>
</div>
