---
import { Icon } from 'astro-icon/components';
import type { LexiCrashHero } from '../types';

interface Props {
    t: LexiCrashHero;
    stores: { googlePlay?: string; appStore?: string };
}

const { t, stores } = Astro.props;
---

<section class="lc-hero">
    <div class="lc-hero-inner">
        <div class="lc-hero-copy">
            <div class="lc-hero-badge">
                <span class="lc-hero-badge-dot">
                    <span class="lc-hero-badge-dot-ping"></span>
                    <span class="lc-hero-badge-dot-inner"></span>
                </span>
                <span class="lc-hero-badge-text">{t.badgeText}</span>
            </div>

            <h1 class="lc-hero-title">
                <span class="sr-only">LexiCrash</span>
                <span class="lc-hero-brand">
                    <img
                        src="/assets/apps/lexi-crash/arcade-master/lexicrash-hero-light.webp"
                        alt="LexiCrash"
                        class="lc-hero-brand-image lc-hero-brand-light"
                    />
                    <img
                        src="/assets/apps/lexi-crash/arcade-master/lexicrash-hero-dark.webp"
                        alt=""
                        class="lc-hero-brand-image lc-hero-brand-dark"
                    />
                </span>
            </h1>

            <p class="lc-hero-subtitle">{t.subtitle}</p>

            <div class="lc-hero-buttons">
                {stores.googlePlay && (
                    <a
                        href={stores.googlePlay}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="lc-hero-btn lc-hero-btn-play"
                    >
                        <Icon name="mdi:google-play" class="lc-hero-btn-icon" />
                        <span class="lc-hero-btn-label">{t.downloadLabel}</span>
                        <span class="lc-hero-btn-name">{t.downloadOnPlay}</span>
                    </a>
                )}
                {stores.appStore && (
                    <a
                        href={stores.appStore}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="lc-hero-btn lc-hero-btn-store"
                    >
                        <Icon name="mdi:apple" class="lc-hero-btn-icon" />
                        <span class="lc-hero-btn-label">{t.downloadLabel}</span>
                        <span class="lc-hero-btn-name">{t.downloadOnStore}</span>
                    </a>
                )}
            </div>
        </div>

        <div class="lc-hero-art" aria-hidden="true">
            <div class="lc-hero-art-glow"></div>
            <div class="lc-hero-showcase">
                <img
                    src="/assets/apps/lexi-crash/arcade-master/08-banner.webp"
                    alt=""
                    class="lc-hero-banner"
                />
                <img
                    src="/assets/apps/lexi-crash/arcade-master/00-splash.webp"
                    alt=""
                    class="lc-hero-splash"
                />
                <div class="lc-hero-art-note">
                    <span class="lc-hero-art-note-icon">&#x2726;</span>
                    {t.artNote && <span>{t.artNote}</span>}
                </div>
            </div>
            <span class="lc-hero-float lc-hero-float-star">&#x2726;</span>
            <span class="lc-hero-float lc-hero-float-bubble"></span>
        </div>
    </div>
</section>
