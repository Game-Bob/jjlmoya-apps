---
import type { FortuneCookieShorts } from '../types';
import YouTubeVideo from '../../../components/YouTubeVideo.astro';

interface Props {
    t: FortuneCookieShorts;
    shorts: string[];
}

const { t, shorts } = Astro.props;
---

{
    shorts.length > 0 && (
        <section class="shorts">
            <div class="shorts-inner">
                <div class="shorts-header">
                    <h2 class="title">{t.title}</h2>
                    <div class="divider" />
                </div>

                <div class="shorts-grid">
                    {shorts.map((videoId, index) => (
                        <div class="video-slot">
                            <YouTubeVideo
                                videoId={videoId}
                                title={`${t.title} ${index + 1}`}
                                poster={index === 0
                                    ? '/assets/apps/fortune-cookie/hero_mystic.webp'
                                    : '/assets/apps/fortune-cookie/screenshot_1.webp'}
                            />
                        </div>
                    ))}

                    <div class="coming-soon-slot">
                        <div class="coming-soon-q">?</div>
                        <div class="coming-soon-label">{t.comingSoonCookies}</div>
                    </div>

                    <div class="coming-soon-slot hidden-mobile">
                        <div class="coming-soon-q">?</div>
                        <div class="coming-soon-label">{t.comingSoonEvents}</div>
                    </div>
                </div>
            </div>
        </section>
    )
}
