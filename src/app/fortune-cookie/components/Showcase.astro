---
import type { FortuneCookieShowcase } from '../types';
import YouTubeVideo from '../../../components/YouTubeVideo.astro';

interface Props {
    t: FortuneCookieShowcase;
}

const { t } = Astro.props;
---

<section class="showcase">
    <div class="showcase-inner">
        <div class="showcase-text">
            <h2 class="title">
                {t.titleStart} <span class="title-accent">{t.titleHighlight}</span> {t.titleEnd}
            </h2>
            <p class="description">{t.description}</p>
        </div>

        <div class="video-wrapper">
            <div class="video-glow"></div>
            <div class="video-frame">
                <YouTubeVideo
                    videoId="Toe9oMcfArg"
                    title={`${t.titleStart} ${t.titleHighlight} ${t.titleEnd}`}
                    poster="/assets/apps/fortune-cookie/hero_mystic.webp"
                />
            </div>
        </div>
    </div>
</section>
