---
import type { DayCheckVideos } from '../types';
import YouTubeVideo from '../../../components/YouTubeVideo.astro';

interface Props {
    t: DayCheckVideos;
    shortIds: string[];
}

const { t, shortIds } = Astro.props;
---

{shortIds.length > 0 && (
    <section class="dc-videos">
        <div class="dc-videos-inner">
            <h2 class="dc-videos-title">{t.title}</h2>
            <div class="dc-videos-grid">
                {shortIds.map((id) => (
                    <div class="dc-video-item">
                        <YouTubeVideo
                            videoId={id}
                            title={t.title}
                            poster="/assets/apps/day-check/hero.webp"
                        />
                    </div>
                ))}
            </div>
        </div>
    </section>
)}
