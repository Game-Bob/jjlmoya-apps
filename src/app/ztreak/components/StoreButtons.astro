---
import { Icon } from 'astro-icon/components';
import type { KnownLocale } from '../../../types';
import { loadZtreakContent } from '../content';
import { ztreakEntry } from '../entry';
import { localizedAppStoreUrl } from '../../../app-store';
interface Props { locale: KnownLocale; }
const { locale } = Astro.props;
const { storeButtons: t } = await loadZtreakContent(locale);
const stores = [
    { name: 'App Store', icon: 'mdi:apple', url: ztreakEntry.stores.appStore ? localizedAppStoreUrl(ztreakEntry.stores.appStore, locale) : undefined },
    { name: 'Google Play', icon: 'mdi:google-play', url: ztreakEntry.stores.googlePlay },
];
---
<div class="zl-stores" role="group" aria-label={t.label}>
    {stores.map(store => {
        const Tag = store.url ? 'a' : 'button';
        return <Tag class="zl-store" href={store.url} disabled={!store.url || undefined} aria-label={store.name + ' — ' + (store.url ? t.download : t.comingSoon)}>
            <Icon name={store.icon} class="zl-store-icon" />
            <span><small>{store.url ? t.download : t.comingSoon}</small><strong>{store.name}</strong></span>
        </Tag>;
    })}
</div>
