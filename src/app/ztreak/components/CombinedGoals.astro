---
import type { KnownLocale } from '../../../types';
import { loadZtreakContent } from '../content';
interface Props { locale: KnownLocale; number: string; }
const { locale, number } = Astro.props;
const { combined: t } = await loadZtreakContent(locale);
const icons = ['M3 4c3-1 6-1 9 1 3-2 6-2 9-1v15c-3-1-6-1-9 1-3-2-6-2-9-1V4Zm9 1v15', 'M9 3c2-1 4 0 4 3 0 2-1 5-3 5S7 9 7 7s0-3 2-4Zm6 10c2-1 4 0 4 3 0 2-1 5-3 5s-3-2-3-4 0-3 2-4Z', 'M12 3v3m0 12v3M3 12h3m12 0h3M5 5l2 2m10 10 2 2M5 19l2-2M17 7l2-2M16 12a4 4 0 1 1-8 0 4 4 0 0 1 8 0Z'];
const activities = [t.read,t.walk,t.stretch];
---
<section class="zl-combined" data-combined-preview data-count={t.count} data-complete={t.complete} data-progress={t.inProgress}><div class="zl-wrap zl-split">
    <div class="zl-section-copy"><p class="zl-eyebrow">{number} / {t.eyebrow}</p><h2>{t.title}<br />{t.titleMiddle}<br /><em>{t.titleAccent}</em></h2><p>{t.description}</p><ol class="zl-combined-steps">{[t.stepGroup,t.stepChoose,t.stepComplete].map((step,index)=><li><span>{String(index+1).padStart(2,'0')}</span>{step}</li>)}</ol></div>
    <div class="zl-combined-art"><div class="zl-combined-card"><div class="zl-combined-card-head"><span class="zl-combined-badge"><svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 3H4v4h4V3Zm12 0h-4v4h4V3Zm-6 14h-4v4h4v-4ZM6 7v5h12V7m-6 5v5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" /></svg></span><div><p>{t.example}</p><h3>{t.routine}</h3></div></div>
    <div class="zl-combined-activities">{activities.map((label,index)=><button type="button" class:list={['zl-combined-activity',{'is-done':index===0}]} aria-pressed={index===0} data-combined-activity><svg class="zl-activity-icon" width="24" height="24" viewBox="0 0 24 24" aria-hidden="true"><path d={icons[index]} fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg><span>{label}</span><span class="zl-combined-check" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24"><path d="m5 12 4 4L19 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg></span></button>)}</div>
    <div class="zl-combined-rule"><p>{t.required}</p><div role="group" aria-label={t.required}>{[1,2,3].map(value=><button type="button" aria-pressed={value===2} data-combined-required={value}>{value} {t.outOf} 3</button>)}</div></div>
    <div class="zl-combined-result" aria-live="polite" aria-atomic="true"><div class="zl-combined-meter" aria-hidden="true"><span class="is-done"></span><span></span><span></span></div><p data-combined-count>{t.count.replace('{done}','1').replace('{total}','3')}</p><strong data-combined-state>{t.inProgress}</strong></div></div><p class="zl-combined-hint">{t.hint}</p></div>
</div></section>
<script>
    for (const preview of document.querySelectorAll<HTMLElement>('[data-combined-preview]')) {
        let required = 2;
        const activities = [...preview.querySelectorAll<HTMLButtonElement>('[data-combined-activity]')];
        const rules = [...preview.querySelectorAll<HTMLButtonElement>('[data-combined-required]')];
        const update = () => {
            const done = activities.filter(button=>button.getAttribute('aria-pressed')==='true').length;
            const complete = done >= required;
            const count = preview.querySelector('[data-combined-count]');
            const state = preview.querySelector('[data-combined-state]');
            if(count)count.textContent=(preview.dataset.count ?? '').replace('{done}',String(done)).replace('{total}',String(activities.length));
            if(state)state.textContent=(complete?preview.dataset.complete:preview.dataset.progress)??'';
            preview.classList.toggle('is-complete',complete);
            preview.querySelectorAll('.zl-combined-meter span').forEach((segment,index)=>segment.classList.toggle('is-done',index<done));
        };
        activities.forEach(button=>button.addEventListener('click',()=>{
            const done=button.getAttribute('aria-pressed')!=='true';
            button.setAttribute('aria-pressed',String(done));
            button.classList.toggle('is-done',done);
            update();
        }));
        rules.forEach(button=>button.addEventListener('click',()=>{
            required=Number(button.dataset.combinedRequired);
            rules.forEach(rule=>rule.setAttribute('aria-pressed',String(rule===button)));
            update();
        }));
    }
</script>
