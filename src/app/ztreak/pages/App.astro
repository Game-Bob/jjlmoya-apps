---
import type { KnownLocale } from '../../../types';
import { ztreakPageUrl, ztreakWebAppUrl } from '../routes';
import { loadZtreakContent } from '../content';
interface Props { locale: KnownLocale; basePath: string; }
const { locale, basePath } = Astro.props;
const { navigation } = await loadZtreakContent(locale);
const landing = ztreakPageUrl(basePath);
const privacy = ztreakPageUrl(basePath, 'privacy');
const webAppUrl = ztreakWebAppUrl(locale, Astro.site?.hostname ?? Astro.url.hostname);
---
<!doctype html>
<html lang={locale}><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="robots" content="noindex,follow" /><meta http-equiv="refresh" content={`0;url=${webAppUrl}`} /><link rel="canonical" href={webAppUrl} /><title>Ztreak</title></head>
<body><main><a href={webAppUrl}>{navigation.openApp}</a><a href={privacy}>{navigation.privacy}</a><a href={landing}>Ztreak</a></main></body></html>
