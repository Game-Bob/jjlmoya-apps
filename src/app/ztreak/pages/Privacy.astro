---
import type { KnownLocale } from '../../../types';
import { privacyContent } from '@gamebob/ztreak/privacy';
import LegalLayout from './LegalLayout.astro';
interface Props { locale: KnownLocale; basePath: string; }
const { locale, basePath } = Astro.props;
const content = privacyContent(locale);
---
<LegalLayout {locale} {basePath} title={content.title}><p>{content.version}</p>{content.sections.map(section => <section><h2>{section.title}</h2><p>{section.text}</p></section>)}</LegalLayout>
<style>
section {
 margin-top: 2rem;
 
}
 h2 {
 font-size: 1.25rem;
 line-height: 1.4;
 
}
</style>
