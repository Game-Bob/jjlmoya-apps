---
import type { KnownLocale } from '../types';

interface Props {
    currentLocale: KnownLocale;
    localeUrls?: Partial<Record<KnownLocale, string>>;
}

const { currentLocale, localeUrls = {} } = Astro.props;

const otherLocales = Object.entries(localeUrls).filter(([l]) => l !== currentLocale) as [KnownLocale, string][];
const toolbarLabels: Record<KnownLocale, { controls: string; toggle: string }> = {
    de: { controls: 'Sprach- und Themensteuerung', toggle: 'Farbschema ändern' },
    en: { controls: 'Language and theme controls', toggle: 'Toggle theme' },
    es: { controls: 'Controles de idioma y tema', toggle: 'Cambiar tema' },
    fr: { controls: 'Commandes de langue et de thème', toggle: 'Changer de thème' },
    id: { controls: 'Kontrol bahasa dan tema', toggle: 'Ubah tema' },
    it: { controls: 'Controlli lingua e tema', toggle: 'Cambia tema' },
    ja: { controls: '言語とテーマの設定', toggle: 'テーマを切り替え' },
    ko: { controls: '언어 및 테마 설정', toggle: '테마 전환' },
    nl: { controls: 'Taal- en thema-instellingen', toggle: 'Thema wijzigen' },
    pl: { controls: 'Ustawienia języka i motywu', toggle: 'Zmień motyw' },
    pt: { controls: 'Controles de idioma e tema', toggle: 'Alternar tema' },
    ru: { controls: 'Настройки языка и темы', toggle: 'Сменить тему' },
    sv: { controls: 'Språk- och temainställningar', toggle: 'Byt tema' },
    tr: { controls: 'Dil ve tema kontrolleri', toggle: 'Temayı değiştir' },
    zh: { controls: '语言和主题控制', toggle: '切换主题' },
};
---

<nav class="preview-toolbar" aria-label={toolbarLabels[currentLocale].controls}>
    {
        otherLocales.length > 0 && (
            <div class="locale-group">
                <span class="locale-current">{currentLocale.toUpperCase()}</span>
                {otherLocales.map(([locale, url]) => (
                    <a href={url} class="btn-locale">
                        {locale.toUpperCase()}
                    </a>
                ))}
            </div>
        )
    }

    <button
        id="theme-toggle"
        class="btn-theme"
        aria-label={toolbarLabels[currentLocale].toggle}
        aria-pressed="false"
        title={toolbarLabels[currentLocale].toggle}
    >
        <span class="theme-icon"></span>
    </button>
</nav>

<script>
    const normalizeTheme = (theme: string) => {
        const aliases: Record<string, string> = {
            light: "theme-light",
            dark: "theme-dark",
            system: "theme-system",
        };
        const normalized = aliases[theme] || theme;
        return ["theme-light", "theme-dark", "theme-system"].includes(normalized)
            ? normalized
            : "theme-system";
    };

    const applyTheme = (theme: string, persist = true) => {
        const selected = normalizeTheme(theme);
        const isDark = selected === "theme-dark" || (
            selected === "theme-system" && window.matchMedia("(prefers-color-scheme: dark)").matches
        );
        const root = document.documentElement;
        root.classList.remove("theme-light", "theme-dark", "theme-system", "dark");
        root.classList.add(selected, isDark ? "theme-dark" : "theme-light");
        root.classList.toggle("dark", isDark);
        if (persist) localStorage.setItem("theme", selected);

        document.getElementById("theme-toggle")?.setAttribute("aria-pressed", String(!isDark));
    };

    function initToolbar() {
        const btn = document.getElementById("theme-toggle");
        if (!btn) return;

        applyTheme(localStorage.getItem("theme") || "theme-system", false);

        btn.onclick = () => {
            const next = document.documentElement.classList.contains("theme-dark")
                ? "theme-light"
                : "theme-dark";
            applyTheme(next);
        };
    }

    initToolbar();
    document.addEventListener("astro:after-swap", initToolbar);

    window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", () => {
        if (normalizeTheme(localStorage.getItem("theme") || "theme-system") === "theme-system") {
            applyTheme("theme-system", false);
        }
    });
</script>

<style>
    .preview-toolbar {
        position: fixed;
        top: 1rem;
        right: 1.5rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        z-index: 1000;
        background: var(--bg-surface);
        padding: 0.4rem;
        border-radius: 1rem;
        border: 1px solid var(--border-color);
        backdrop-filter: blur(12px);
    }

    .locale-group {
        display: flex;
        align-items: center;
        gap: 0.25rem;
        padding-right: 0.5rem;
        border-right: 1px solid var(--border-color);
    }

    .locale-current {
        font-size: 0.7rem;
        font-weight: 900;
        color: var(--text-muted);
        padding: 0.4rem 0.6rem;
        letter-spacing: 0.08em;
    }

    .btn-locale {
        background: transparent;
        border: 1px solid var(--border-color);
        color: var(--text-main);
        cursor: pointer;
        padding: 0.4rem 0.7rem;
        border-radius: 0.5rem;
        font-weight: 700;
        font-size: 0.7rem;
        text-decoration: none;
        letter-spacing: 0.08em;
        transition: all 0.2s ease;
    }

    .btn-locale:hover {
        border-color: var(--accent);
        color: var(--text-main);
    }

    .btn-locale:focus-visible,
    .btn-theme:focus-visible {
        outline: 2px solid var(--text-main);
        outline-offset: 2px;
    }

    .btn-theme {
        background: transparent;
        border: none;
        cursor: pointer;
        padding: 0.5rem;
        border-radius: 0.6rem;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background 0.2s ease;
    }

    .btn-theme:hover {
        background: rgba(255, 255, 255, 0.08);
    }

    .theme-icon {
        display: block;
        width: 16px;
        height: 16px;
        border-radius: 50%;
    }

    :global(.theme-light) .theme-icon {
        background: #f59e0b;
        box-shadow: 0 0 8px #fbbf24;
    }

    :global(.theme-dark) .theme-icon {
        background: #94a3b8;
        box-shadow: inset -4px -2px 0 #1e293b;
    }

    @media (max-width: 768px) {
        .preview-toolbar {
            inset: max(0.5rem, env(safe-area-inset-top)) max(0.5rem, env(safe-area-inset-right)) auto
                max(0.5rem, env(safe-area-inset-left));
            gap: 0.25rem;
            max-width: none;
            padding: 0.3rem;
        }

        .locale-group {
            flex: 1 1 auto;
            min-width: 0;
            overflow: auto hidden;
            overscroll-behavior-x: contain;
            scrollbar-color: var(--text-muted) transparent;
            scrollbar-width: thin;
            -webkit-overflow-scrolling: touch;
        }

        .locale-current,
        .btn-locale {
            flex: 0 0 auto;
        }

        .btn-theme {
            flex: 0 0 2.5rem;
            min-height: 2.5rem;
        }
    }
</style>
