---
interface Props {
    videoId: string;
    title: string;
    poster: string;
}

const { videoId, title, poster } = Astro.props;
---

<figure class="yt-video" data-youtube-video={videoId} data-youtube-title={title} aria-label={title}>
    <img class="yt-video-poster" src={poster} alt="" loading="lazy" decoding="async" />
    <button class="yt-video-play" type="button" aria-label={title} title={title}>
        <span class="yt-video-play-icon" aria-hidden="true"></span>
    </button>
    <a
        class="yt-video-external"
        href={`https://www.youtube.com/watch?v=${videoId}`}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={title}
    >
        YouTube <span aria-hidden="true">↗</span>
    </a>
</figure>

<script>
    import { isYouTubeFramePolicyViolation } from '../utils/youtube-csp';

    document.addEventListener('securitypolicyviolation', (event) => {
        if (!isYouTubeFramePolicyViolation(event)) return;

        document.querySelectorAll<HTMLElement>('[data-youtube-video].is-playing').forEach((frame) => {
            frame.querySelector('.yt-video-player')?.remove();
            frame.classList.remove('is-playing');
            frame.classList.add('is-blocked');
        });
    });

    const mountYouTubePlayer = (button: HTMLButtonElement) => {
        const frame = button.closest<HTMLElement>('[data-youtube-video]');
        const videoId = frame?.dataset.youtubeVideo;
        if (!frame || !videoId || frame.classList.contains('is-playing')) return;

        const player = document.createElement('iframe');
        player.className = 'yt-video-player';
        player.src = `https://www.youtube-nocookie.com/embed/${encodeURIComponent(videoId)}?autoplay=1&controls=1&playsinline=1&rel=0&modestbranding=1`;
        player.title = frame.dataset.youtubeTitle || 'YouTube video';
        player.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
        player.allowFullscreen = true;
        player.loading = 'eager';
        player.referrerPolicy = 'strict-origin-when-cross-origin';
        frame.classList.add('is-playing');
        frame.append(player);
        button.remove();
    };

    document.addEventListener('click', (event) => {
        if (!(event.target instanceof Element)) return;

        const button = event.target.closest<HTMLButtonElement>('.yt-video-play');
        if (button) mountYouTubePlayer(button);
    });
</script>

<style is:global>
    .yt-video {
        --yt-video-ink: #111116;
        --yt-video-paper: #fff;

        position: relative;
        isolation: isolate;
        display: block;
        width: 100%;
        height: 100%;
        min-width: 0;
        margin: 0;
        overflow: hidden;
        border-radius: inherit;
        background: #101116;
    }

    .yt-video::after {
        position: absolute;
        z-index: 1;
        inset: 0;
        content: "";
        background: linear-gradient(180deg, #08090a00 48%, #08090a9c 100%);
        pointer-events: none;
    }

.yt-video-poster {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 600ms cubic-bezier(0.2, 0.75, 0.25, 1);
    }

.yt-video:hover .yt-video-poster {
        transform: scale(1.035);
    }

.yt-video-play {
        position: absolute;
        z-index: 2;
        top: 50%;
        left: 50%;
        display: grid;
        width: 4.25rem;
        height: 4.25rem;
        padding: 0;
        place-items: center;
        color: var(--yt-video-ink);
        cursor: pointer;
        background: var(--yt-video-paper);
        border: 1px solid #ffffffb3;
        border-radius: 50%;
        box-shadow: 0 0.75rem 2rem #0005;
        transform: translate(-50%, -50%);
        transition: transform 220ms ease, box-shadow 220ms ease, background-color 220ms ease;
    }

.yt-video-play:hover {
        background: #fff4cf;
        box-shadow: 0 1rem 2.5rem #0007;
        transform: translate(-50%, -50%) scale(1.08);
    }

.yt-video-play:focus-visible,
.yt-video-external:focus-visible {
        outline: 3px solid #fff;
        outline-offset: 4px;
        box-shadow: 0 0 0 4px #101116, 0 0.75rem 2rem #0005;
    }

.yt-video-play-icon {
        width: 0;
        height: 0;
        margin-left: 0.25rem;
        border-top: 0.55rem solid transparent;
        border-bottom: 0.55rem solid transparent;
        border-left: 0.85rem solid currentcolor;
    }

.yt-video-external {
        position: absolute;
        z-index: 5;
        right: 0.75rem;
        bottom: 0.75rem;
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.45rem 0.7rem;
        color: var(--yt-video-paper);
        font: 700 0.68rem/1 system-ui, sans-serif;
        text-decoration: none;
        letter-spacing: 0.04em;
        background: #08090ac7;
        border: 1px solid #ffffff36;
        border-radius: 999px;
        backdrop-filter: blur(8px);
        transition: background-color 180ms ease, border-color 180ms ease, transform 180ms ease;
    }

.yt-video-external:hover {
        background: #08090af0;
        border-color: #ffffff70;
        transform: translateY(-1px);
    }

.yt-video.is-blocked .yt-video-external {
    background: #08090af5;
    border-color: #ffffff80;
    box-shadow: 0 0 0 2px #ffffff24, 0 0.75rem 2rem #0005;
}

.yt-video-player {
        position: absolute;
        z-index: 4;
        inset: 0;
        display: block;
        width: 100%;
        height: 100%;
        border: 0;
        background: #101116;
    }

    @media (max-width: 360px) {
        .yt-video-external {
            right: 0.375rem;
            bottom: 0.375rem;
            gap: 0.2rem;
            padding: 0.4rem 0.45rem;
            font-size: 0.625rem;
            letter-spacing: 0;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .yt-video-poster,
        .yt-video-play,
        .yt-video-external {
            transition: none;
        }

        .yt-video:hover .yt-video-poster,
        .yt-video-external:hover {
            transform: none;
        }
    }
</style>
